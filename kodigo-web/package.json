{
  "name": "kodigo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "content:import": "node scripts/import-bootcamps.mjs",
    "content:check": "node scripts/import-bootcamps.mjs --check",
    "test:e2e": "node scripts/e2e.mjs",
    "test:content": "node tests/content/import.test.mjs",
    "test": "npm run test:content && npm run test:e2e:prod && npm run test:demo",
    "start": "serve dist",
    "test:e2e:prod": "node scripts/e2e.mjs --prod",
    "dev:demo": "vite --mode demo",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --port 4174",
    "test:demo": "node scripts/e2e.mjs --demo",
    "assets:build": "node scripts/build-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "serve": "^14.2.6",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
